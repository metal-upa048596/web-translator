{
    "manifest_version": 3,

    "name": "Web Translator",

    "version": "1.1.0",

    "description": "웹페이지에서 선택한 텍스트를 원하는 언어로 번역하는 Chrome 확장 프로그램",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "https://translate.googleapis.com/*"
    ],

    "background": {
        "service_worker": "service-worker.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],

            "js": [
                "content.js"
            ],

            "css": [
                "style.css"
            ]
        }
    ],

    "action": {
        "default_title": "Web Translator"
    }
}
