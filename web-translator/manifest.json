{
  "manifest_version": 3,
  "name": "Web Translator",
  "version": "1.0.0",
  "description": "웹페이지의 텍스트를 번역하기 위한 Chrome 확장 프로그램",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_title": "Web Translator"
  }
}